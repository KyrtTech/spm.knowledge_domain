@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix spm: <http://the-spm.org/schema#> .

# Class that inherits from schema:SoftwareApplication
spm:SemanticVersioningApplication a rdfs:Class ;
    rdfs:subClassOf schema:SoftwareApplication .

# Property to represent semantic versioning
spm:hasSemanticVersion a rdf:Property ;
    rdfs:label "Semantic Version" ;
    rdfs:comment "A property to represent a software's version according to Semantic Versioning 2.0.0" ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:string .

spm:creator a rdf:Property ;
    rdfs:label "Creator" ;
    rdfs:comment "The individual, team, or organization responsible for creating the application." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range foaf:Agent .

# Extending SemanticVersioningApplication with a release date property
spm:releaseDate a rdf:Property ;
    rdfs:label "Release Date" ;
    rdfs:comment "The release date of the software version." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:date .

# Property for End of Life (EOL) date
spm:endOfLifeDate a rdf:Property ;
    rdfs:label "End of Life Date" ;
    rdfs:comment "The date on which the software version is considered to be at the end of its life." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:date .

# Class for Operating System Family
spm:OperatingSystemFamily a rdfs:Class ;
    rdfs:label "Operating System Family" ;
    rdfs:comment "A class representing families of operating systems." .

# OperatingSystem
spm:OperatingSystem a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:label "Operating System" ;
    rdfs:comment "An operating system that serves as the foundational software that manages computer hardware and software resources and provides common services for computer programs." .

# Property linking Operating System to its Family
spm:belongsToFamily a rdf:Property ;
    rdfs:domain spm:OperatingSystem ;  # Assuming spm:OperatingSystem is already defined
    rdfs:range spm:OperatingSystemFamily ;
    rdfs:comment "Indicates the family to which the operating system belongs." .

# DevelopmentPlatformFamily
spm:DevelopmentPlatformFamily a rdfs:Class ;
    rdfs:label "Development Platform Family" ;
    rdfs:comment "A family of Dev Platform. This is a way of grouping and addressing a development platform ignoring the versions and allowing of each version to have different properties" .

# DevelopmentPlatform
spm:DevelopmentPlatform a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:label "Development Platform" ;
    rdfs:comment "A software application that provides development tools and environments." .

spm:dependsOn a rdf:Property ;
    rdfs:domain spm:DevelopmentPlatform ;
    rdfs:range spm:OperatingSystem .

spm:belongsToFamily a rdf:Property ;
    rdfs:domain spm:DevelopmentPlatform ;
    rdfs:range spm:DevelopmentPlatformFamily .

# Define PackageManager as a subclass of SemanticSoftwareApplication
spm:PackageManager a rdfs:Class ;
    rdfs:subClassOf spm:SemanticSoftwareApplication ;
    rdfs:comment "A package manager is a programming language's tool to create project environments and easily import external dependencies." .

# Property for default registry URL
spm:defaultRegistry a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The default registry URL where packages are stored and managed." .

# Property for lock file name
spm:lockFileName a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:string ;
    rdfs:comment "The conventional name for the lock file used by the package manager." .

# Property for dependency file name
spm:dependencyFileName a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the file that lists the dependencies for projects using this package manager." .

# Property to link PackageManager to DevelopmentPlatform
spm:isUsedForPlatform a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range spm:DevelopmentPlatform ;
    rdfs:comment "Associates a package manager with the development platform it is used for." .


# CloudProviderServices class
spm:CloudServiceType a rdfs:Class .


# Class for Infrastructure Provider
spm:InfrastructureProvider a rdfs:Class ;
    rdfs:comment "An entity that provides the physical or virtual infrastructure for deploying software applications." .

# CloudProvider class
spm:CloudProvider a rdfs:Class ;
    rdfs:subClassOf spm:InfrastructureProvider ;
    rdfs:label "Cloud Provider" ;
    rdfs:comment "A provider of cloud-based infrastructure services, offering scalable and flexible computing resources over the internet." .

spm:hasName a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range xsd:string .

spm:offersService a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range spm:CloudServiceType .

spm:operatesInRegion a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range xsd:string .

# Class for Configuration Parameters
spm:ConfigParam a rdfs:Class ;
    rdfs:comment "A configuration parameter required by the different software entities, with name, description, and default value." .

# Property for the name of the ConfigParam
spm:paramName a rdf:Property ;
    rdfs:domain spm:ConfigParam ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the configuration parameter." .

# Property for the description of the ConfigParam
spm:paramDescription a rdf:Property ;
    rdfs:domain spm:ConfigParam ;
    rdfs:range xsd:string ;
    rdfs:comment "A description of what the configuration parameter does." .

# Property for the default value of the ConfigParam
spm:defaultValue a rdf:Property ;
    rdfs:domain spm:ConfigParam ;
    rdfs:range xsd:string ;
    rdfs:comment "The default value of the configuration parameter." .

# InstallStrategy class
spm:InstallStrategy a rdfs:Class ;
    rdfs:comment "The process of installing a software application to different providers, including cloud platforms, bare metal servers, or local development setups." .

# Property linking InstallStrategy to Infrastructure Provider
spm:usesInfrastructureProvider a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:InfrastructureProvider ;
    rdfs:comment "Indicates the infrastructure provider used for the install strategy." .

# Property linking InstallStrategy to SemanticVersioningApplication
spm:targetsApplication a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:SemanticVersioningApplication ;
    rdfs:comment "Links an install strategy to a SemanticVersioningApplication it installs." .

# Property for dependencies on other SemanticVersioningApplications
spm:hasDependency a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:SemanticVersioningApplication ;
    rdfs:comment "Indicates a dependency of the install strategy on another SemanticVersioningApplication." .

# Property for listing configuration parameters
spm:hasConfigParam a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:ConfigParam ;
    rdfs:comment "A configuration parameter required by the install strategy." .