@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix spm: <http://the-spm.org/schema#> .

# Class that inherits from schema:SoftwareApplication
spm:SemanticVersioningApplication a rdfs:Class ;
    rdfs:subClassOf schema:SoftwareApplication .
# Property to represent semantic versioning
spm:hasSemanticVersion a rdf:Property ;
    rdfs:label "Semantic Version" ;
    rdfs:comment "A property to represent a software's version according to Semantic Versioning 2.0.0" ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:string .

spm:creator a rdf:Property ;
    rdfs:label "Creator" ;
    rdfs:comment "The individual, team, or organization responsible for creating the application." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range foaf:Agent .

# Extending SemanticVersioningApplication with a release date property
spm:releaseDate a rdf:Property ;
    rdfs:label "Release Date" ;
    rdfs:comment "The release date of the software version." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:date .

# Property for End of Life (EOL) date
spm:endOfLifeDate a rdf:Property ;
    rdfs:label "End of Life Date" ;
    rdfs:comment "The date on which the software version is considered to be at the end of its life." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range xsd:date .

# Property to represent semant
spm:dependsOnSemanticApp a rdf:Property ;
    rdfs:label "Dep on Semantic Application" ;
    rdfs:comment "Indicates a dependency of this semantic app on another semantic app." ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range spm:SemanticVersioningApplication .

spm:ApplicationFamily a rdfs:Class ;
    rdfs:subClassOf schema:SoftwareApplication ;
    rdfs:comment "A product/application family independent of a specific release version." .

spm:applicationBelongsToFamily a rdf:Property ;
    rdfs:label "Application belongs to family" ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range spm:ApplicationFamily ;
    rdfs:comment "Links a concrete versioned application to its version-independent application family." .

spm:ApplicationDependencyRequirement a rdfs:Class ;
    rdfs:comment "A dependency requirement against an application family, optionally constrained by a semantic-version range." .

spm:dependsOnApplicationRequirement a rdf:Property ;
    rdfs:domain spm:SemanticVersioningApplication ;
    rdfs:range spm:ApplicationDependencyRequirement ;
    rdfs:comment "Links an application or service to a family-level dependency requirement." .

spm:requiresApplicationFamily a rdf:Property ;
    rdfs:domain spm:ApplicationDependencyRequirement ;
    rdfs:range spm:ApplicationFamily ;
    rdfs:comment "The application family required by a dependency requirement." .

spm:minSemanticVersion a rdf:Property ;
    rdfs:domain spm:ApplicationDependencyRequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "Inclusive minimum semantic version accepted by a dependency requirement." .

spm:maxSemanticVersion a rdf:Property ;
    rdfs:domain spm:ApplicationDependencyRequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "Exclusive maximum semantic version accepted by a dependency requirement." .

spm:versionConstraint a rdf:Property ;
    rdfs:domain spm:ApplicationDependencyRequirement ;
    rdfs:range xsd:string ;
    rdfs:comment "A semantic-version range expression for a dependency requirement, for example '>=7.0 <8.0'." .

spm:RemoteFileEntry a rdfs:Class ;
    rdfs:comment "A remote file entry. This can be used to represent a remote file structure." .

spm:accessUrl a rdf:Property ;
    rdfs:domain spm:RemoteFileEntry ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "A file remote address" .

spm:localPath a rdf:Property ;
    rdfs:domain spm:RemoteFileEntry ;
    rdfs:range xsd:string ;
    rdfs:comment "A local file path for a file system." .

# Class for Operating System Family
spm:OperatingSystemFamily a rdfs:Class ;
    rdfs:label "Operating System Family" ;
    rdfs:comment "A class representing families of operating systems." .

# OperatingSystem
spm:OperatingSystem a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:label "Operating System" ;
    rdfs:comment "An operating system that serves as the foundational software that manages computer hardware and software resources and provides common services for computer programs." .

# Property linking an operating system to its family (distinct from platform family — see spm:platformBelongsToFamily)
spm:osBelongsToFamily a rdf:Property ;
    rdfs:label "OS belongs to family" ;
    rdfs:domain spm:OperatingSystem ;
    rdfs:range spm:OperatingSystemFamily ;
    rdfs:comment "Indicates the operating-system family to which this OS belongs." .

# DevelopmentPlatformFamily
spm:DevelopmentPlatformFamily a rdfs:Class ;
    rdfs:label "Development Platform Family" ;
    rdfs:comment "A family of Dev Platform. This is a way of grouping and addressing a development platform ignoring the versions and allowing of each version to have different properties" .

# DevelopmentPlatform
spm:DevelopmentPlatform a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:label "Development Platform" ;
    rdfs:comment "A software application that provides development tools and environments." .

spm:dependsOn a rdf:Property ;
    rdfs:domain spm:DevelopmentPlatform ;
    rdfs:range spm:OperatingSystem .

spm:platformBelongsToFamily a rdf:Property ;
    rdfs:label "Platform belongs to family" ;
    rdfs:domain spm:DevelopmentPlatform ;
    rdfs:range spm:DevelopmentPlatformFamily ;
    rdfs:comment "Indicates the development-platform family to which this platform belongs." .

# Define PackageManager as a subclass of SemanticVersioningApplication
spm:PackageManager a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:comment "A package manager is a programming language's tool to create project environments and easily import external dependencies." .

# Property for default registry URL
spm:defaultRegistry a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "The default registry URL where packages are stored and managed." .

# Property for lock file name
spm:lockFileName a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:string ;
    rdfs:comment "The conventional name for the lock file used by the package manager." .

# Property for dependency file name
spm:dependencyFileName a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the file that lists the dependencies for projects using this package manager." .

# Property to link PackageManager to DevelopmentPlatform
spm:isUsedForPlatform a rdf:Property ;
    rdfs:domain spm:PackageManager ;
    rdfs:range spm:DevelopmentPlatform ;
    rdfs:comment "Associates a package manager with the development platform it is used for." .

# Base class for Configuration Parameters
spm:ConfigParameter a rdfs:Class ;
    rdfs:comment "A general class for different types of configuration parameters." .

# CloudProviderServices class
spm:CloudServiceType a rdfs:Class .

# Class for Infrastructure Provider
spm:InfrastructureProvider a rdfs:Class ;
    rdfs:comment "An entity that provides the physical or virtual infrastructure for deploying software applications." .

spm:infrastructureHasConfigParameter a rdfs:Class ;
    rdfs:domain spm:InfrastructureProvider ;
    rdfs:range rdfs:Class ;
    rdfs:comment "Associates an infrastructure provider with various configuration parameters." .

# CloudProvider class
spm:CloudProvider a rdfs:Class ;
    rdfs:subClassOf spm:InfrastructureProvider ;
    rdfs:label "Cloud Provider" ;
    rdfs:comment "A provider of cloud-based infrastructure services, offering scalable and flexible computing resources over the internet." .

spm:hasName a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range xsd:string .

spm:offersService a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range spm:CloudServiceType .

spm:operatesInGeoRegion a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range spm:GeoRegion .

# Class for GeoRegion
spm:GeoRegion a rdfs:Class ;
    rdfs:comment "Represents a broad geographic region, including continents and significant sub-regions within continents." .

spm:regionName a rdf:Propery ;
    rdfs:label "Region Name" ;
    rdfs:domain spm:GeoRegion ;
    rdfs:range xsd:string ;
    rdfs:comment "The name of the region" .

spm:regionOptStatus a rdf:Property ;
    rdfs:label "Region operational status" ;
    rdfs:domain spm:GeoRegion ;
    rdfs:range xsd:string ;
    rdfs:comment "For provider-specific cloud regions, indicates availability (e.g. ENABLED_BY_DEFAULT, DISABLED). Optional on broad geographic regions." .

spm:hasRegion a rdf:Property ;
    rdfs:domain spm:CloudProvider ;
    rdfs:range spm:GeoRegion ;
    rdfs:comment "Geographic or cloud API regions offered by this cloud provider." .

# Extend the general GeoRegion class for AWS-specific regions
spm:AWSRegion a rdfs:Class ;
    rdfs:subClassOf spm:GeoRegion, spm:ConfigParameter ;
    rdfs:label "AWS region" ;
    rdfs:comment "Represents a geographic region specifically operated by AWS." .

spm:awsRegionName a rdf:Property ;
    rdfs:label "AWS region id" ;
    rdfs:domain spm:AWSRegion ;
    rdfs:range xsd:string ;
    rdfs:comment "AWS API region identifier (e.g. us-east-1)." .

spm:GCPRegion a rdfs:Class ;
    rdfs:subClassOf spm:GeoRegion, spm:ConfigParameter ;
    rdfs:label "GCP region" ;
    rdfs:comment "Represents a geographic region operated by Google Cloud Platform." .

spm:gcpRegionName a rdf:Property ;
    rdfs:label "GCP region id" ;
    rdfs:domain spm:GCPRegion ;
    rdfs:range xsd:string ;
    rdfs:comment "GCP API region identifier (e.g. us-central1)." .

spm:AzureRegion a rdfs:Class ;
    rdfs:subClassOf spm:GeoRegion, spm:ConfigParameter ;
    rdfs:label "Azure region" ;
    rdfs:comment "Represents a geographic region operated by Microsoft Azure." .

spm:azureRegionName a rdf:Property ;
    rdfs:label "Azure region name" ;
    rdfs:domain spm:AzureRegion ;
    rdfs:range xsd:string ;
    rdfs:comment "Azure resource manager region name (e.g. eastus)." .

spm:HetznerLocation a rdfs:Class ;
    rdfs:subClassOf spm:GeoRegion, spm:ConfigParameter ;
    rdfs:label "Hetzner Cloud location" ;
    rdfs:comment "A Hetzner Cloud location (API name location); used when creating servers and other resources." .

spm:hetznerLocationName a rdf:Property ;
    rdfs:label "Hetzner location id" ;
    rdfs:domain spm:HetznerLocation ;
    rdfs:range xsd:string ;
    rdfs:comment "Hetzner Cloud API location name (e.g. fsn1, nbg1)." .

# Property for availability zone of the subnet
spm:inAvailabilityZone a rdf:Property ;
    rdfs:domain spm:Subnet ;
    rdfs:range xsd:string ;
    rdfs:comment "The availability zone in which the subnet resides." .


spm:Parameter a rdfs:Class ;
  rdfs:comment "A parameter that can be used as input to or output from an install strategy." .

# Properties for Parameter
spm:parameterName a rdf:Property ;
  rdfs:domain spm:Parameter ;
  rdfs:range xsd:string ;
  rdfs:comment "The name of the install parameter." .

spm:parameterValue a rdf:Property ;
  rdfs:domain spm:Parameter ;
  rdfs:range xsd:string ;
  rdfs:comment "The value of the install parameter." .

spm:parameterDescription a rdf:Property ;
  rdfs:domain spm:Parameter ;
  rdfs:range xsd:string ;
  rdfs:comment "A description of the install parameter." .

spm:defaultValue a rdf:Property ;
  rdfs:domain spm:Parameter ;
  rdfs:range xsd:string ;
  rdfs:comment "The default value for the install parameter." .

spm:isFile a rdf:Property ;
  rdfs:domain spm:Parameter ;
  rdfs:range xsd:boolean ;
  rdfs:comment "Indicates whether the parameter is expected to be a file path (true) or not (false)." .

# Property definition for isBuildable
spm:isBuildable a rdf:Property ;
  rdfs:label "is Buildable" ;
  rdfs:comment "Indicates whether the resource can be built or generated through a build strategy. True means it is buildable, false means it is not." ;
  rdfs:range xsd:boolean .

# Class for ParameterDependency
spm:ParameterDependency a rdfs:Class ;
    rdfs:comment "Encapsulates a dependency that links a specific parameter to a required value." .

# Property to link to the Parameter
spm:onParameter a rdf:Property ;
    rdfs:domain spm:ParameterDependency ;
    rdfs:range spm:Parameter ;
    rdfs:comment "The parameter that this dependency concerns." .

spm:onApplication a rdf:Property ;
    rdfs:domain spm:ParameterDependency ;
    rdfs:range  spm:SemanticVersioningApplication ;
    rdfs:comment "The semantic versioned app this dependency concerns." .

spm:onApplicationRequirement a rdf:Property ;
    rdfs:domain spm:ParameterDependency ;
    rdfs:range spm:ApplicationDependencyRequirement ;
    rdfs:comment "The family-level application dependency requirement this parameter dependency concerns." .

# Property to specify the required value
spm:minValue a rdf:Property ;
    rdfs:domain spm:ParameterDependency ;
    rdfs:range xsd:string ;
    rdfs:comment "The specific required value for the parameter." .

# Property to specify the required value
spm:recommendedValue a rdf:Property ;
    rdfs:domain spm:ParameterDependency ;
    rdfs:range xsd:string ;
    rdfs:comment "The specific required value for the parameter." .

spm:Argument a rdfs:Class ;
    rdfs:comment "Represents an argument passed to an install strategy, which refers to a Parameter definition and can be renamed locally." .

# Property for Arguments to refer to Parameter types
spm:argumentType a rdf:Property ;
    rdfs:domain spm:Argument ;
    rdfs:range spm:Parameter ;
    rdfs:comment "The Parameter type that defines the type of data this argument expects." .

# Property to optionally rename the Argument within the context of its use
spm:argumentName a rdf:Property ;
    rdfs:domain spm:Argument ;
    rdfs:range xsd:string ;
    rdfs:comment "An optional new name for the argument within the context of a specific InstallStrategy." .

spm:argumentDescription a rdf:Property ;
    rdfs:domain spm:Argument ;
    rdfs:range xsd:string ;
    rdfs:comment "An optional description of the argument within the context of a specific InstallStrategy." .

# Property to specify allowed values for an argument
spm:allowedValues a rdf:Property ;
    rdfs:domain spm:Argument ;
    rdfs:range rdf:List ;
    rdfs:comment "A list of allowed values that this argument can take, restricting the possible values of the parameter." .

# InstallStrategy class
spm:InstallStrategy a rdfs:Class ;
    rdfs:comment "The process of installing a software application to different providers, including cloud platforms, bare metal servers, or local development setups." .

# Property linking InstallStrategy to Infrastructure Provider
spm:usesInfrastructureProvider a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:InfrastructureProvider ;
    rdfs:comment "Indicates the infrastructure provider used for the install strategy." .

# Property linking InstallStrategy to SemanticVersioningApplication
spm:targetsApplication a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:SemanticVersioningApplication ;
    rdfs:comment "Links an install strategy to a SemanticVersioningApplication it installs." .

# Property for dependencies on other SemanticVersioningApplications
spm:hasDependency a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:SemanticVersioningApplication ;
    rdfs:comment "Indicates a dependency of the install strategy on another SemanticVersioningApplication." .

# Property indicating an install parameter is an output of an install strategy
spm:producesParam a rdf:Property ;
  rdfs:domain spm:InstallStrategy ;
  rdfs:range spm:Parameter ;
  rdfs:comment "Indicates an install parameter is produced as an output by this install strategy." .

# Property to link InstallStrategy to its Arguments
spm:requiresArgument a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:Argument ;
    rdfs:comment "Links an install strategy to its arguments, each of which is a specific, possibly renamed use of a Parameter type." .

# Property indicating an install argument is optional (as input) by an install strategy
spm:optionalArgument a rdf:Property ;
  rdfs:domain spm:InstallStrategy ;
  rdfs:range spm:Argument ;
  rdfs:comment "Indicates an install argument is optional as input by this install strategy." .

# Property indicating the install scripts for an InstallStrategy
spm:installScripts a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Links an install strategy to the scripts that need to be run for the strategy to work." .

# Property indicating the uninstall scripts for an InstallStrategy
spm:uninstallScripts a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Links an install strategy to the scripts that need to be run for the strategy to remove any resources it created." .

# Property indicating support files for an install stategy
spm:supportFiles a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:RemoteFileEntry ;
    rdfs:comment "Support files for an install strategy scripts. The main case is for install strategies that use a IaC products" .

# Property specifying the Runner for an InstallStrategy
spm:executedOnRunner a rdf:Property ;
    rdfs:domain spm:InstallStrategy ;
    rdfs:range spm:Runner ;
    rdfs:comment "Specifies the Runner on which the install strategy is executed." .

# Define SoftwareService as a subclass of SemanticVersioningApplication
spm:SoftwareService a rdfs:Class ;
    rdfs:subClassOf spm:SemanticVersioningApplication ;
    rdfs:comment "A software service that may depend on specific development platforms, configuration parameters, and other software services." .

# Property indicating dependencies on other SoftwareServices
spm:dependsOnService a rdf:Property ;
    rdfs:domain spm:SoftwareService ;
    rdfs:range spm:SoftwareService ;
    rdfs:comment "Indicates a dependency of this software service on another software service." .

# Property indicating the download URL for a SoftwareService
spm:downloadURL a rdf:Property ;
    rdfs:domain spm:SoftwareService ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "A URL from where the software service can be downloaded." .

spm:serviceHasDependencyParameter a rdf:Property ;
    rdfs:domain spm:SoftwareService ;
    rdfs:range spm:ParameterDependency ;
    rdfs:comment "Links a software service to one or more ParameterDependencies that specify the necessary configuration parameters and their required values." .

spm:Runner a rdfs:Class ;
    rdfs:label "Runner" ;
    rdfs:comment "Represents the environment where an installation will be executed. This could be a local machine, a virtual machine, a containerized environment, or a CI/CD pipeline" .

# Property linking Runner to its Operating System
spm:runsOnOperatingSystem a rdf:Property ;
    rdfs:domain spm:Runner ;
    rdfs:range spm:OperatingSystem ;
    rdfs:comment "Specifies the operating system that the runner is using." .

# Property linking Runner to SemanticVersioningApplications it supports
spm:supportsApplication a rdf:Property ;
    rdfs:domain spm:Runner ;
    rdfs:range spm:SemanticVersioningApplication ;
    rdfs:comment "Indicates the semantic versioning applications that are installed or required on the runner." .
