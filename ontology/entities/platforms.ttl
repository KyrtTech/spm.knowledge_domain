@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix spm: <http://the-spm.org/schema#> .
@prefix schema: <http://schema.org/> .

@prefix spm_platforms: <http://the-spm.org/entities/platforms/> .

# NodeJS

# Dev Family
spm_platforms:NodeJS a spm:DevelopmentPlatformFamily ;
    dcterms:title "NodeJS".

spm_platforms:NodeJS16 a spm:DevelopmentPlatform ;
    dcterms:title "Node.js 16"@en ;
    schema:alternateName "Gallium"@en ;
    spm:hasSemanticVersion "16.0.0" ;
    spm:releaseDate "2021-04-20"^^xsd:date ;
    spm:endOfLifeDate "2024-04-30"^^xsd:date ;
    spm:belongsToFamily spm_platforms:NodeJS ;
    dcterms:creator "OpenJS Foundation" ;
    foaf:homepage <https://nodejs.org/en/about/releases/> .

spm_platforms:NodeJS18 a spm:DevelopmentPlatform ;
    dcterms:title "Node.js 18"@en ;
    schema:alternateName "Hydrogen"@en ;
    spm:hasSemanticVersion "18.19.0" ;
    spm:releaseDate "2023-11-29"^^xsd:date ;
    spm:endOfLifeDate "2025-04-30"^^xsd:date ;
    spm:belongsToFamily spm_platforms:NodeJS ;
    dcterms:creator "OpenJS Foundation" ;
    foaf:homepage <https://nodejs.org/en/about/releases/> .

spm_platforms:NodeJS20 a spm:DevelopmentPlatform ;
    dcterms:title "Node.js 20"@en ;
    schema:alternateName "Iron"@en ;
    spm:hasSemanticVersion "20.11.0" ;
    spm:releaseDate "2024-01-09"^^xsd:date ;
    spm:endOfLifeDate "2026-04-30"^^xsd:date ;
    spm:belongsToFamily spm_platforms:NodeJS ;
    dcterms:creator "OpenJS Foundation" ;
    foaf:homepage <https://nodejs.org/en/about/releases/> .