@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix spm: <http://the-spm.org/schema#> .

@prefix spm_config_params: <http://the-spm.org/entities/config_params/> .

spm_config_params:maxThreads a spm:ConfigParam ;
    spm:paramName "MAX_THREADS" ;
    spm:paramDescription "Maximum number of threads." ;
    spm:defaultValue "4" .

spm_config_params:env a spm:ConfigParam ;
    spm:paramName "ENV" ;
    spm:paramDescription "Deployment environment." ;
    spm:defaultValue "production" .

spm_config_params:loggingLevel a spm:ConfigParam ;
    spm:paramName "LOGGING_LEVEL" ;
    spm:paramDescription "The granularity of log messages to output." ;
    spm:defaultValue "INFO" .  # Other values could be DEBUG, WARN, ERROR

spm_config_params:databaseURL a spm:ConfigParam ;
    spm:paramName "DATABASE_URL" ;
    spm:paramDescription "The URL connection string for the database." ;
    spm:defaultValue "" .