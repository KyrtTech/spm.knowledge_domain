# Class for AWS VPC
spm_cloud_providers:AWSVPC a rdfs:Class ;
    rdfs:label "VPC" ;
    rdfs:comment "Represents an AWS Virtual Private Cloud, which provides a logically isolated section of the AWS Cloud." ;
    spm:isBuildable "true"^^xsd:boolean .

spm_cloud_providers:vpcId a rdf:Property ;
    rdfs:domain spm_cloud_providers:AWSVPC ;
    rdfs:range xsd:string ;
    rdfs:comment "The unique identifier of the VPC." .

# Property for subnets within a VPC
spm_cloud_providers:hasSubnet a rdf:Property ;
    rdfs:domain spm_cloud_providers:AWSVPC ;
    rdfs:range spm_cloud_providers:AWSSubnet ;
    rdfs:comment "Associates subnets with a VPC." .

# Class for Subnets
spm_cloud_providers:AWSSubnet a rdfs:Class ;
    rdfs:comment "Represents a subnet within an AWS VPC, defining a segmented part of the VPC's IP address range." .

spm_cloud_providers:AWS a spm:CloudProvider ;
    dcterms:title "Amazon Web Services" ;
    dcterms:description "A comprehensive, evolving cloud computing platform provided by Amazon." ;
    foaf:homepage <https://aws.amazon.com/> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/9/93/Amazon_Web_Services_Logo.svg> ;
    spm:offersService spm_cloud_service:ComputeService, spm_cloud_service:StorageService, spm_cloud_service:DatabaseService, spm_cloud_service:MachineLearningService, spm_cloud_service:CDN ;
    spm:operatesInGeoRegion spm_geo_regions:NorthAmerica, spm_geo_regions:Europe, spm_geo_regions:AsiaPacific ;
    spm:hasRegion spm_cloud_providers:awsAfSouth1, spm_cloud_providers:awsApEast1, spm_cloud_providers:awsApNortheast1, spm_cloud_providers:awsApNortheast2, spm_cloud_providers:awsApNortheast3, spm_cloud_providers:awsApSouth1, spm_cloud_providers:awsApSouth2, spm_cloud_providers:awsApSoutheast1, spm_cloud_providers:awsApSoutheast2, spm_cloud_providers:awsApSoutheast3, spm_cloud_providers:awsApSoutheast4, spm_cloud_providers:awsApSoutheast5, spm_cloud_providers:awsEuCentral1, spm_cloud_providers:awsEuCentral2, spm_cloud_providers:awsEuWest1, spm_cloud_providers:awsEuWest2, spm_cloud_providers:awsEuWest3, spm_cloud_providers:awsEuSouth1, spm_cloud_providers:awsEuSouth2, spm_cloud_providers:awsEuNorth1, spm_cloud_providers:awsCaCentral1, spm_cloud_providers:awsCaWest1, spm_cloud_providers:awsUsEast1, spm_cloud_providers:awsUsEast2, spm_cloud_providers:awsUsWest1, spm_cloud_providers:awsUsWest2, spm_cloud_providers:awsIlCentral1, spm_cloud_providers:awsMeCentral1, spm_cloud_providers:awsMeSouth1, spm_cloud_providers:awsSaEast1 ;
    spm:infrastructureHasConfigParameter spm:AWSRegion, spm_cloud_providers:AWSVPC.

spm_cloud_providers:GCP a spm:CloudProvider ;
    dcterms:title "Google Cloud Platform" ;
    dcterms:description "A suite of cloud computing services that runs on the same infrastructure that Google uses internally for its end-user products." ;
    foaf:homepage <https://cloud.google.com/> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/5/51/Google_Cloud_logo.svg> ;
    spm:offersService spm_cloud_service:ComputeService, spm_cloud_service:StorageService, spm_cloud_service:DatabaseService, spm_cloud_service:MachineLearningService, spm_cloud_service:CDN ;
    spm:operatesInGeoRegion spm_geo_regions:NorthAmerica, spm_geo_regions:SouthAmerica, spm_geo_regions:Europe, spm_geo_regions:AsiaPacific, spm_geo_regions:Asia, spm_geo_regions:Africa, spm_geo_regions:MiddleEast, spm_geo_regions:Oceania ;
