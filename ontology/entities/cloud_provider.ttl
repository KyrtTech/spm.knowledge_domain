spm_cloud_providers:Hetzner a spm:CloudProvider ;
    dcterms:title "Hetzner Cloud" ;
    dcterms:description "Hetzner Cloud provides virtual machines, networking, and storage for deploying applications in European, US, and Asia-Pacific data centers." ;
    foaf:homepage <https://www.hetzner.com/cloud> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/0/0c/Logo_Hetzner.svg> ;
    spm:offersService spm_cloud_service:ComputeService, spm_cloud_service:StorageService ;
    spm:operatesInGeoRegion spm_geo_regions:Europe, spm_geo_regions:NorthAmerica, spm_geo_regions:Asia, spm_geo_regions:AsiaPacific ;
    spm:hasRegion spm_cloud_providers:hetznerFsn1, spm_cloud_providers:hetznerNbg1, spm_cloud_providers:hetznerHel1, spm_cloud_providers:hetznerAsh, spm_cloud_providers:hetznerHil, spm_cloud_providers:hetznerSin ;
    spm:hasServerType spm_cloud_providers:cpx11, spm_cloud_providers:cpx21, spm_cloud_providers:cpx31, spm_cloud_providers:cpx41, spm_cloud_providers:cpx51, spm_cloud_providers:ccx13, spm_cloud_providers:ccx23, spm_cloud_providers:ccx33, spm_cloud_providers:ccx43, spm_cloud_providers:ccx53, spm_cloud_providers:ccx63, spm_cloud_providers:cpx12, spm_cloud_providers:cpx22, spm_cloud_providers:cpx32, spm_cloud_providers:cpx42, spm_cloud_providers:cpx52, spm_cloud_providers:cpx62 ;
    spm:infrastructureHasConfigParameter spm:HetznerLocation, spm:ServerType .
