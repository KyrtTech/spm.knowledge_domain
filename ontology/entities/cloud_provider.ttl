# Hetzner Cloud server types, generated from currently orderable hcloud server-type values.
spm_cloud_providers:cpx11 a spm:ServerType ;
    dcterms:title "CPX 11" ;
    spm:serverTypeName "cpx11" ;
    spm:serverTypeCategory "regular_purpose" ;
    spm:serverTypeCores 2 ;
    spm:serverTypeMemoryGB "2"^^xsd:decimal ;
    spm:serverTypeDiskGB 40 ;
    spm:serverTypeCpuType "shared" ;
    spm:serverTypeArchitecture "x86" ;
