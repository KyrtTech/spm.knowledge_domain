@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix spm: <http://the-spm.org/schema#> .

@prefix spm_services: <http://the-spm.org/entities/services#> .

@prefix spm_apps: <http://the-spm.org/entities/apps#> .

@prefix spm_platforms: <http://the-spm.org/entities/platforms#> .
@prefix spm_params: <http://the-spm.org/entities/params#> .

spm_services:Suri a spm:SoftwareService ;
    dcterms:title "Suri" ;
    schema:logo <https://raw.githubusercontent.com/surishortlink/suri/development/logo.png>;
    spm:hasSemanticVersion "0.5.1" ;
    spm:dependsOnSemanticApp spm_platforms:NodeJS18 ;  # Assuming this is the correct reference for NodeJS version 18
    spm:downloadURL "https://github.com/jstayton/suri/archive/refs/tags/v0.5.1.zip" .

# Kutt service
spm_services:Kutt a spm:SoftwareService ;
    dcterms:title "Kutt" ;
    schema:logo <https://raw.githubusercontent.com/thedevs-network/kutt/9d1c873897c3f5b9a1bd0c74dc5d23f2ed01f2ec/static/images/logo-github.png> ;
    spm:hasSemanticVersion "2.7.4" ;
    spm:dependsOnSemanticApp spm_platforms:NodeJS18 ;
    spm:dependsOnApplicationRequirement spm_services:KuttRedisRequirement, spm_services:KuttPostgresRequirement ;
    spm:serviceHasDependencyParameter spm_services:KuttNodeJS18vCPU, spm_services:KuttNodeJS18Storage, spm_services:KuttPostgresvCPU, spm_services:KuttPostgresStorage ;
    spm:downloadURL "https://github.com/thedevs-network/kutt/archive/refs/tags/v2.7.4.zip" ;
    dcterms:description "Kutt is a free, open-source URL shortener with a robust API that provides features like custom URLs, detailed stats, and more." .

spm_services:KuttRedisRequirement a spm:ApplicationDependencyRequirement ;
    spm:requiresApplicationFamily spm_apps:Redis ;
    spm:minSemanticVersion "7.0.0" ;
    spm:maxSemanticVersion "8.0.0" ;
    spm:versionConstraint ">=7.0.0 <8.0.0" .

spm_services:KuttPostgresRequirement a spm:ApplicationDependencyRequirement ;
    spm:requiresApplicationFamily spm_apps:Postgres ;
    spm:minSemanticVersion "16.0.0" ;
    spm:maxSemanticVersion "17.0.0" ;
    spm:versionConstraint ">=16.0.0 <17.0.0" .

# Define ParameterDependencies for NodeJS18
spm_services:KuttNodeJS18vCPU a spm:ParameterDependency ;
    spm:onParameter spm_params:vCPU ;
    spm:onApplication spm_platforms:NodeJS18;
    spm:minValue "2" ;
    spm:recommendedValue "4" .

spm_services:KuttNodeJS18Storage a spm:ParameterDependency ;
    spm:onParameter spm_params:storage ;
    spm:onApplication spm_platforms:NodeJS18;
    spm:minValue "20GB" ;
    spm:recommendedValue "50GB" .

# Define ParameterDependencies for Postgres
spm_services:KuttPostgresvCPU a spm:ParameterDependency ;
    spm:onParameter spm_params:vCPU ;
    spm:onApplicationRequirement spm_services:KuttPostgresRequirement ;
    spm:minValue "4" ;
    spm:recommendedValue "8" .

spm_services:KuttPostgresStorage a spm:ParameterDependency ;
    spm:onParameter spm_params:storage ;
    spm:onApplicationRequirement spm_services:KuttPostgresRequirement ;
    spm:minValue "100GB" ;
    spm:recommendedValue "200GB" .

# END Kutt


# Wordpress
spm_services:Wordpress a spm:SoftwareService ;
    dcterms:title "Wordpress" ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/0/09/Wordpress-Logo.svg> ;
    spm:hasSemanticVersion "7.0" ;
    spm:dependsOnSemanticApp spm_platforms:PHP83 ;
    #spm:dependsOnApplicationRequirement spm_services:KuttRedisRequirement, spm_services:KuttPostgresRequirement ;
    #spm:serviceHasDependencyParameter spm_services:KuttNodeJS18vCPU, spm_services:KuttNodeJS18Storage, spm_services:KuttPostgresvCPU, spm_services:KuttPostgresStorage ;
    spm:downloadURL "https://wordpress.org/wordpress-7.0.zip" ;
    dcterms:description "WordPress is a web content management system. WordPress is written in the PHP programming language and paired with a MySQL or MariaDB database" .
# END Wordpress
