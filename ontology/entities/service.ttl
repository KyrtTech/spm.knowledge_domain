@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix spm: <http://the-spm.org/schema#> .

@prefix spm_services: <http://the-spm.org/entities/services/> .

@prefix spm_platforms: <http://the-spm.org/entities/platforms/> .

spm_services:Suri a spm:Service ;
    dcterms:title "Suri" ;
    spm:hasVersion "0.5.1" ;
    spm:dependsOnSemanticApp spm_platforms:NodeJS18 ;  # Assuming this is the correct reference for NodeJS version 18
    spm:downloadURL <https://github.com/jstayton/suri/archive/refs/tags/v0.5.1.zip> .