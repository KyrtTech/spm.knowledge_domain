@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix spm: <http://the-spm.org/schema#> .

@prefix spm_params: <http://the-spm.org/entities/params/> .

# Instances of Parameter

spm_params:env a spm:Parameter ;
    spm:paramName "env" ;
    spm:defaultValue "production" ;
    spm:paramDescription "Environment type (e.g., development, staging, production)." .

spm_params:maxThreads a spm:Parameter ;
    spm:paramName "maxThreads" ;
    spm:defaultValue "4" ;
    spm:paramDescription "Maximum number of threads." .

spm_params:sshKeyAsString a spm:Parameter ;
    spm:paramName "sshKeyAsString" ;
    spm:defaultValue "ssh-rsa AAAA..." ;
    spm:paramDescription "SSH string for secure connections." .

spm_params:sshKey a spm:Parameter ;
    spm:paramName "sshKey" ;
    spm:defaultValue "/path/to/ssh/key" ;
    spm:paramDescription "Path to the SSH key file." ;
    spm:isFile "true"^^xsd:bolean .

spm_params:sshConnectionString a spm:Parameter ;
    spm:paramName "sshConnectionString" ;
    spm:defaultValue "user@hostname" ;
    spm:paramDescription "The SSH connection string used for secure shell access, typically in the format user@hostname." .

spm_params:databaseURL a spm:Parameter ;
    spm:paramName "databaseURL" ;
    spm:defaultValue "jdbc:mysql://localhost:3306/mydatabase" ;
    spm:paramDescription "URL to the database." .

spm_params:databaseName a spm:Parameter ;
    spm:paramName "databaseName" ;
    spm:defaultValue "mydatabase" ;
    spm:paramDescription "Name of the database." .

spm_params:databaseUsername a spm:Parameter ;
    spm:paramName "databaseUsername" ;
    spm:defaultValue "admin" ;
    spm:paramDescription "Username for the database" .

spm_params:databasePassword a spm:Parameter ;
    spm:paramName "databasePassword" ;
    spm:defaultValue "" ;
    spm:paramDescription "Password for the database" .

spm_params:ip a spm:Parameter ;
    spm:paramName "ip" ;
    spm:defaultValue "192.168.1.1" ;
    spm:paramDescription "IP address of the service." .

spm_params:port a spm:Parameter ;
    spm:paramName "port" ;
    spm:defaultValue "80" ;
    spm:paramDescription "Port number for the service." .

spm_params:awsRegion a spm:Parameter ;
    spm:paramName "awsRegion" ;
    spm:defaultValue "us-east-1" ;  # Default to North Virginia; adjust as needed
    spm:paramDescription "The AWS region where resources are deployed and managed." .

spm_params:ec2InstanceId a spm:Parameter ;
    spm:paramName "ec2InstanceId" ;
    spm:defaultValue "" ;
    spm:paramDescription "The unique identifier of an EC2 instance." .

spm_params:jsonConfigFile a spm:Parameter ;
    spm:paramName "jsonConfigFile" ;
    spm:defaultValue "config.json" ;
    spm:paramDescription "Path to the JSON configuration file." ;
    spm:isFile "true"^^xsd:boolean .

spm_params:yamlConfigFile a spm:Parameter ;
    spm:paramName "yamlConfigFile" ;
    spm:defaultValue "config.yaml" ;
    spm:paramDescription "Path to the YAML configuration file." ;
    spm:isFile "true"^^xsd:boolean .

spm_params:tomlConfigFile a spm:Parameter ;
    spm:paramName "tomlConfigFile" ;
    spm:defaultValue "config.toml" ;
    spm:paramDescription "Path to the TOML configuration file." ;
    spm:isFile "true"^^xsd:boolean .

spm_params:url a spm:Parameter ;
    spm:paramName "url" ;
    spm:defaultValue "" ;  # Assuming the default value might be empty, adjust as necessary
    spm:paramDescription "The URL used for accessing a resource or endpoint." ;
    spm:isFile "false"^^xsd:boolean .

spm_params:redisHost a spm:Parameter ;
    spm:paramName "redisHost" ;
    spm:defaultValue "localhost" ;
    spm:paramDescription "The host/url for accessing a Redis server" ;
    spm:isFile "false"^^xsd:boolean .

spm_params:redisPort a spm:Parameter ;
    spm:paramName "redisPort" ;
    spm:defaultValue "6379" ;
    spm:paramDescription "The port for accessing a Redis server" ;
    spm:isFile "false"^^xsd:boolean .

spm_params:redisUser a spm:Parameter ;
    spm:paramName "redisUser" ;
    spm:defaultValue "redis" ;
    spm:paramDescription "The username for accessing a Redis server" ;
    spm:isFile "false"^^xsd:boolean .

spm_params:redisPassword a spm:Parameter ;
    spm:paramName "redisPass" ;
    spm:defaultValue "pass" ;
    spm:paramDescription "The password for accessing a Redis server" ;
    spm:isFile "false"^^xsd:boolean .

spm_params:redisConnectionString a spm:Parameter ;
    spm:paramName "redisConnectionString" ;
    spm:defaultValue "" ;
    spm:paramDescription "A connection string for a redis instance" ;
    spm:isFile "false"^^xsd:boolean .