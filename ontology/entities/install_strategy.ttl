@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

@prefix spm: <http://the-spm.org/schema#> .
@prefix spm_cloud_providers: <http://the-spm.org/entities/cloud_providers/> .
@prefix spm_platforms: <http://the-spm.org/entities/platforms/> .
@prefix spm_params: <http://the-spm.org/entities/params/> .
@prefix spm_services: <http://the-spm.org/entities/services/> .
@prefix spm_runners: <http://the-spm.org/entities/runners/> .

@prefix spm_install_strategy: <http://the-spm.org/entities/install-strategies/> .


# Assuming the existence of ConfigParams relevant to the Node 18 install on AWS
spm_install_strategy:Node18AWS a spm:InstallStrategy ;
    dcterms:title "Install Node 18 on AWS" ;
    dcterms:description "This install strategy outlines the steps to create an AWS EC2 instance specifically for running Node 18. It includes the application of a security policy that opens up port 80 to allow HTTP traffic, ensuring the Node application is accessible over the web." ;
    spm:targetsApplication spm_platforms:NodeJS18 ;
    spm:usesInfrastructureProvider spm_cloud_providers:AWS ;
    spm:producesParam spm_params:sshConnectionString, spm_params:sshKey, spm_params:ec2InstanceId ;
    spm:installScripts <https://github.com/KyrtTech/spm.install_strategies/blob/master/Node18AWS/install.sh?raw=true> ;
    spm:documentation <https://example.com/install-node18-aws> ;
    spm:executedOnRunner spm_runners:LinuxRunnerWithAWS .

spm_install_strategy:SuriInstall a spm:InstallStrategy ;
    dcterms:title "Install Suri on remote server using ssh" ;
    dcterms:description "Install strategy for Suri, requiring IP, SSH connection string, and SSH key." ;
    spm:targetsApplication spm_services:Suri ;
    spm:requiresArgument spm_install_strategy:SuriInstallSSHConnectionString, spm_install_strategy:SuriInstallSSHKey ;
    spm:optionalArgument spm_install_strategy:SuriInstallLinksConfig ;
    spm:producesParam spm_params:url ;
    spm:installScripts <https://github.com/KyrtTech/spm.install_strategies/blob/master/Suri/install.sh?raw=true> ;
    spm:executedOnRunner spm_runners:LinuxRunnerWithAWS .

spm_install_strategy:SuriInstallSSHConnectionString a spm:Argument ;
    spm:argumentType spm_params:sshConnectionString.

spm_install_strategy:SuriInstallSSHKey a spm:Argument ;
    spm:argumentType spm_params:sshKey .

spm_install_strategy:SuriInstallLinksConfig a spm:Argument ;
    spm:argumentType spm_params:jsonConfigFile ;
    spm:argumentName "linksConfig" ;
    spm:argumentDescription "The key is the 'shortlink' path that gets redirected, and the value is the target URL. Keys can be as short or as long as you want, using whatever mixture of characters you want. / is a special entry for redirecting the root path." .